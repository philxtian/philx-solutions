# PHILX Solutions — Contact Form Environment Variables
# Copy this file to .env and fill in real values for local development.
# In production (Vercel), set these under Project Settings > Environment Variables.

# Cloudflare Turnstile site key — public, safe to expose client-side.
# This is also hardcoded directly in partials/contact.html's turnstile.render() call
# and in the Turnstile widget markup; kept here only for documentation/reference.
NEXT_PUBLIC_CLOUDFLARE_SITE_KEY=your-turnstile-site-key

# Cloudflare Turnstile secret key — server-side only, used in api/contact.js
# to verify tokens against https://challenges.cloudflare.com/turnstile/v0/siteverify
# Must be the matching secret for the site key above (Cloudflare dashboard > Turnstile).
CLOUDFLARE_SECRET_KEY=your-turnstile-secret-key

# Resend API key — server-side only, used to send the contact notification email.
RESEND_API_KEY=your-resend-api-key

# Verified "from" address for outbound contact notification emails.
# Must belong to a domain verified in your Resend account (Resend dashboard > Domains).
# Falls back to notifications@philxsolutions.com in api/contact.js if unset.
RESEND_FROM_EMAIL=PHILX Solutions <notifications@philxsolutions.com>

# Google Analytics Measurement ID
GA_MEASUREMENT_ID=G-XXXXXXXXXX
